---
title : "sitemap"
sitemap_exclude: y
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
    
    <!-- Homepage -->
    <url>
      <loc>{{ site.url }}/</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>weekly</changefreq>
      <priority>1.0</priority>
    </url>
    
    <!-- About Page -->
    <url>
      <loc>{{ site.url }}/about/</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.8</priority>
    </url>
    
    <!-- Posts Index -->
    <url>
      <loc>{{ site.url }}/posts/</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.9</priority>
    </url>
    
    <!-- Photo Essays Index -->
    <url>
      <loc>{{ site.url }}/photo_essays/</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.9</priority>
    </url>
    
    <!-- Tags Page -->
    <url>
      <loc>{{ site.url }}/tags/</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.6</priority>
    </url>
    
    <!-- Blog Posts -->
    {% for post in site.posts %}
    <url>
      <loc>{{ site.url }}{{ post.url | remove: 'index.html' }}</loc>
      {% if post.lastmod %}
        <lastmod>{{ post.lastmod | date_to_xmlschema }}</lastmod>
      {% else %}
        <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
      {% endif %}
      <changefreq>yearly</changefreq>
      <priority>0.7</priority>
    </url>
    {% endfor %}
    
    <!-- Projects -->
    <url>
      <loc>{{ site.url }}/projects/granules/</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.9</priority>
    </url>
    
    <!-- Photo Essays -->
    {% assign photo_essay_dirs = "360km,athens_pride,burning_man_2015,burning_man_2016,california_101,dafne,dark_woods,finally_normal_people,fog_and_cold,kythira,on_the_road,on_the_road2,roadtrip_snapshots,roadtrip_snapshots_2,stories_from_the_pandemic,submerged,underwater" | split: ',' %}
    {% for essay in photo_essay_dirs %}
    <url>
      <loc>{{ site.url }}/photo_essays/{{ essay }}/</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>yearly</changefreq>
      <priority>0.8</priority>
    </url>
    {% endfor %}
    
    <!-- Other Pages -->
    {% for page in site.pages %}
    {% if page.layout != nil %}
    {% if page.layout != 'feed' %}
    {% if page.sitemap_exclude != 'y' %}
    {% unless page.url contains '/projects/' or page.url contains '/photo_essays/' or page.url == '/' or page.url == '/about/' or page.url == '/posts/' or page.url == '/tags/' %}
    <url>
        <loc>{{ site.url }}{{ page.url | remove: 'index.html' }}</loc>
        <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.5</priority>
    </url>
    {% endunless %}
    {% endif %}
    {% endif %}
    {% endif %}
    {% endfor %}
</urlset>
